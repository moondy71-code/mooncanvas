{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "lib": ["ES2022", "WebWorker", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../src/features/live/protocol.ts", "../src/features/recording/types.ts", "../src/features/recording/session.ts"],
  "exclude": ["src/**/*.test.ts"]
}
